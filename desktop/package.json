{
  "name": "investai-workbench",
  "productName": "InvestAI",
  "version": "3.2.0",
  "description": "优势资本 · 智能投研工作台（桌面版）",
  "author": "InvestAI",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-src": "node scripts/prepare.mjs",
    "start": "node scripts/prepare.mjs && electron .",
    "dist:mac": "node scripts/prepare.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/prepare.mjs && electron-builder --win --publish never",
    "dist": "node scripts/prepare.mjs && electron-builder --mac --publish never && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.0.12",
    "resedit": "2.0.3"
  },
  "build": {
    "appId": "com.investai.workbench",
    "productName": "InvestAI",
    "copyright": "优势资本",
    "artifactName": "InvestAI-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main.cjs",
      "app-src/**",
      "!app-src/**/*.map",
      "!app-src/node_modules/@napi-rs/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "InvestAI ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "优势资本 智能投研",
      "uninstallDisplayName": "优势资本 智能投研（InvestAI）",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
