{
  "name": "@local/investai-desktop",
  "version": "3.0.0",
  "description": "优势资本智能投研 项目管理 DSH 插件（流程进度百分比 + 插件提交 + 多维笔记看板 + 左上本地 PPT/Word/录音转文字工坊 + 本地离线/云端 API）",
  "type": "module",
  "private": true,
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "core",
    "app",
    "server.mjs",
    "cordis.patch.yml",
    "README.md",
    "GLOSSARY.md",
    "docs",
    "scripts",
    "fixtures",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "node server.mjs --desktop",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "eval": "node scripts/eval.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "setup-asr": "sh scripts/setup-asr.sh",
    "demo-video": "node scripts/demo/record.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "3.12.0"
  }
}
